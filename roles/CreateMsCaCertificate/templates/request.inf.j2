[NewRequest]
Subject = "CN={{ cert_cn }}, O=EvOrigin, OU=Lab, L=Jax, ST=FL, C=US"
KeyLength = "{{ KeyLength }}"
KeySpec = 1
KeyUsage = 0xA0  ; Digital Signature, Key Encipherment
Exportable = TRUE
MachineKeySet = TRUE
RequestType = PKCS10
ProviderName = "Microsoft RSA SChannel Cryptographic Provider"
ProviderType = 12
SMIME = FALSE

[Extensions]
; Basic Constraints
2.5.29.19 = "{text}"
_continue_ = "CA=FALSE"

; Subject Alternative Name
2.5.29.17 = "{text}"
{% if Wildcard | bool %}
; *.domain does not match the bare domain, so list both
_continue_ = "DNS={{ cert_cn }}&"
_continue_ = "DNS={{ Domain }}"
{% else %}
_continue_ = "DNS={{ cert_cn }}"
{% endif %}

[RequestAttributes]
CertificateTemplate = "{{ cert_template }}"
